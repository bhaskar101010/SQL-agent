# Copy this file to `.env` and fill in your keys. `.env` is gitignored.
# You can leave any provider blank; the router skips cohorts whose keys are missing.

# --- Gemini (primary cohort) ---
# Put 1-4 keys, comma-separated. Router round-robins across them.
GEMINI_API_KEYS=
GEMINI_STRONG_MODEL=gemini-2.5-flash
GEMINI_CHEAP_MODEL=gemini-2.5-flash-lite

# --- Groq (fallback cohort) ---
GROQ_API_KEY=
GROQ_STRONG_MODEL=openai/gpt-oss-120b
GROQ_CHEAP_MODEL=openai/gpt-oss-20b

# --- OpenRouter (last-resort cohort) ---
OPENROUTER_API_KEY=
OPENROUTER_STRONG_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_CHEAP_MODEL=google/gemini-2.0-flash-exp:free

# --- Rate limiting (min seconds between any two calls in that cohort) ---
# Gemini free tier is 10 RPM per project (keys share quota) -> 7s is safe.
GEMINI_MIN_INTERVAL=7
GROQ_MIN_INTERVAL=0
OPENROUTER_MIN_INTERVAL=0

# --- App ---
CHINOOK_DB_PATH=data/Chinook_Sqlite.sqlite
